# 이 파일을 .env로 복사한 뒤 실제 값을 입력하세요.
# 저장소가 공개되어 있으므로 실제 비밀값이 들어간 .env는 커밋하지 마세요.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/gojeom
DB_USERNAME=gojeom
DB_PASSWORD=gojeom

# --- JWT ---
# HS256 서명용으로 최소 32바이트 이상의 충분히 긴 무작위 문자열을 사용하세요.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# 모델 ID는 코드에 하드코딩하지 않고 환경 변수로 고정합니다.
OPENAI_MODEL_TEXT=
OPENAI_MODEL_IMAGE=

# --- Object Storage (S3 호환) ---
# 얼굴 사진은 생체정보에 준하므로 국내 리전을 사용합니다.
STORAGE_ENDPOINT=
STORAGE_REGION=ap-northeast-2
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Google OAuth ---
# Google Cloud Console > 사용자 인증 정보 > OAuth 클라이언트 ID(웹 애플리케이션)
# ID 토큰 검증 방식이므로 클라이언트 시크릿은 필요하지 않습니다.
GOOGLE_CLIENT_ID=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
